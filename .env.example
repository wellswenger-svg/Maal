# App
APP_HOST=0.0.0.0
APP_PORT=8000

# Auth — leave empty to disable unlock. Never commit real PINs or hashes.
# Format: bcryptHash:ownerId,bcryptHash:ownerId
# Generate: cd frontend && npm run hash-pin -- <pin>
WAN_PINS=
WAN_AUTH_SECRET=
WAN_ADMIN_OWNER=u9977

# Comma-separated, or * for all
CORS_ORIGINS=*
# true = serve frontend/dist from API (local). false on Render.
AI_ENGINE_DEV_MODE=false
# Conditional VLM (slot planner.default_model). Leave path empty to degrade to rules-only.
AI_ENGINE_VLM_ENABLED=true
AI_ENGINE_VLM_MODEL_PATH=

# MongoDB — all media lives here only
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/?appName=Cluster0
MONGODB_DB=wan_studio

# ComfyUI
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SEC=2400
COMFYUI_DIR=

ZERO_RESIDUE=true
SCRUB_PASSES=1
SCRUB_CLEAR_ALL_HISTORY=true

# IMG — Flux
FLUX_UNET=flux1-dev-fp8.safetensors
FLUX_CLIP_L=clip_l.safetensors
FLUX_T5=t5xxl_fp8_e4m3fn.safetensors
FLUX_VAE=ae.safetensors
FLUX_GUIDANCE=4.0
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_DENOISE=0.55
IMAGE_DENOISE_CAP=0.85
SAMPLER_STEPS=28
# true = pass user prompt through (best adherence); false = legacy preserve wrappers
RAW_PROMPT=true

# VID — Wan 2.2 I2V 14B
WAN_UNET_HIGH=wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors
WAN_UNET_LOW=wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors
WAN_VAE=wan_2.1_vae.safetensors
WAN_CLIP=umt5_xxl_fp8_e4m3fn_scaled.safetensors
WAN_SHIFT=5.0
VIDEO_WIDTH=640
VIDEO_HEIGHT=640
VIDEO_LENGTH=49
VIDEO_FPS=16
VIDEO_STEPS=20
